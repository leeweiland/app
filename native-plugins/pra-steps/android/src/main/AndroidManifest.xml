<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Runtime "Physical activity" permission the step-counter sensor needs on Android 10+. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />

    <!-- Health Connect: daily step totals from every app/device that syncs into it (watches, rings). -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application>
        <!-- Android 13 and lower: Health Connect's "privacy policy" link. -->
        <activity
            android:name="com.pacificrimathleticsapp.steps.HealthPermissionsRationaleActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Android 14+: the same link, from the system's Health Connect settings. -->
        <activity-alias
            android:name="com.pacificrimathleticsapp.steps.ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity="com.pacificrimathleticsapp.steps.HealthPermissionsRationaleActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
